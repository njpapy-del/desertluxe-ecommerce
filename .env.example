# ── Base de données ────────────────────────────────────────────────────────────
# Local  : postgresql://postgres:password@localhost:5432/desertluxe
# Render : fourni automatiquement via render.yaml
DATABASE_URL="postgresql://postgres:password@localhost:5432/desertluxe"

# ── NextAuth ───────────────────────────────────────────────────────────────────
# Local      : http://localhost:3000
# Production : https://desertluxe-frontend.onrender.com
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-with: openssl rand -base64 32"

# Admin (changer en production)
ADMIN_EMAIL="admin@desertluxe.com"
ADMIN_PASSWORD="DesertLuxe2024!"

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Chatbot Ollama / Qwen (local) ─────────────────────────────────────────────
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# ── OpenAI (fallback si Ollama non dispo) ─────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ── Cloudinary (upload images produits) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── WhatsApp Business ──────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="+33600000000"
WHATSAPP_ACCESS_TOKEN="EAAx..."
WHATSAPP_PHONE_NUMBER_ID="12345678"

# ── App URLs ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL du backend Express (après déploiement Render)
NEXT_PUBLIC_API_URL="http://localhost:4000"
