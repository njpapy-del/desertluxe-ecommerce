# ══════════════════════════════════════════════════════════════════════════════
# MA LUXURY — Variables d'environnement
# Dev  → copier en .env.local
# Prod → coller dans Vercel Dashboard > Settings > Environment Variables
# ══════════════════════════════════════════════════════════════════════════════

# ── URL de l'application ───────────────────────────────────────────────────────
# Dev  : http://localhost:3000
# Prod : https://ma-luxury.vercel.app  (ou votre domaine custom)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Supabase / PostgreSQL ──────────────────────────────────────────────────────
# Pooler pgbouncer — runtime Prisma (port 6543, transaction mode)
DATABASE_URL="postgresql://postgres.vbcjzviuyidszpftmrvr:[PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connexion directe — migrations Prisma uniquement (port 5432)
DIRECT_URL="postgresql://postgres.vbcjzviuyidszpftmrvr:[PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:5432/postgres"
# Clés publiques Supabase JS (optionnel — pour futur client-side queries)
NEXT_PUBLIC_SUPABASE_URL="https://vbcjzviuyidszpftmrvr.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-anon-key-supabase"

# ── NextAuth ───────────────────────────────────────────────────────────────────
# Générer le secret : openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Chatbot IA — Groq (gratuit, remplace Ollama en prod) ──────────────────────
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"
# OpenAI fallback (optionnel)
OPENAI_API_KEY="sk-..."

# ── WhatsApp Business ──────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="+971522110904"
WHATSAPP_ACCESS_TOKEN="EAAx..."
WHATSAPP_PHONE_NUMBER_ID="votre-phone-number-id"
